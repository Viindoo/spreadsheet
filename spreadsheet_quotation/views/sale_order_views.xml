<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.spreadsheet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="has_spreadsheet" invisible="1" />
                <!-- Technical: drives the Calculator smart-button visibility -->
                <field name="spreadsheet_id" invisible="1" />
                <!-- Technical: stores the linked calculator spreadsheet -->
                <button
                    name="action_open_spreadsheet_calculator"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-table"
                    invisible="not has_spreadsheet"
                >
                    <span>Calculator</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
